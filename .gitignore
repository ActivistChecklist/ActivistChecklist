# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/

# production
/build
/out
/out-dev

# misc
*.tsbuildinfo
.DS_Store
*.pem
.agents
.claude
package-lock.json

# IDE related
.idea
.cursorrules
.cursor/

# debug
npm-debug.log*
pnpm-debug.log*
logs/

# local env files
.env*
!.env.template

# vercel
.vercel

# pagefind (search indexing tool)
public/pagefind

/pages/playground.js*
/playground
**/playground/***
.image-cache.json

# Server-side deploy state
.deploy-lock.sha256

# Backups
buildbackups/

# Generated OG share images
public/images/og/

# Guide PDFs (scripts/build-pdfs.mjs): rendered cache and its content hashes
public/pdf/
.pdf-cache.json
.pdf-deferred.json
# Designed PDFs (scripts/build-designed-pdfs.mjs): same idea, from content/<locale>/pdf/
public/files/pdf/
.designed-pdf-cache.json

# Auto-generated endoflife.date snapshot (regenerated daily by scripts/fetch-endoflife-snapshot.mjs)
public/data/eol-snapshot.json

# Metadata cleaner folder
metadata-cleaner/

# SSL check log
.ssl-check.log

# Deploy lock file (flock in scripts/build-deploy.sh)
.build-deploy.lock

# Set when a newer commit arrives mid-build; the running deploy rebuilds for it
.build-deploy.pending

# The commit ac-api last started from, kept by scripts/build-deploy.sh
.build-deploy.api-rev

# The commit the last publish put live, and what scripts/deploy-poll.sh last
# started a build for
.build-deploy.live-rev
.build-deploy.live-rev.tmp
.build-deploy.poll

# Deploy log and one-line-per-run history written by scripts/deploy-detached.sh
.deploy.log
.deploy-history.log
