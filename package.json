{
  "name": "activistchecklist",
  "version": "1.0.0",
  "description": "ActivistChecklist.org",
  "license": "GPL-3.0",
  "private": true,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "prepare": "node scripts/prepare.js",
    "install:ci": "pnpm install --frozen-lockfile --prefer-offline --fetch-timeout 100000",
    "start": "next start",
    "clean": "rm -rf .next build node_modules out && pnpm store prune && pnpm install",
    "dev": "concurrently -n \"API,NEXT\" -c \"blue,green\" \"NODE_NO_WARNINGS=1 pnpm api:dev\" \"pnpm next:dev\"",
    "next:dev": "next dev --turbopack",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:paths": "node scripts/trailing-slash-paths.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix:paths": "node scripts/trailing-slash-paths.mjs --fix",
    "fetch-news": "node scripts/fetch-news-images.js",
    "fetch:eol": "node scripts/fetch-endoflife-snapshot.mjs",
    "store:prune": "bash scripts/prune-pnpm-store.sh",
    "news": "node scripts/news-wizard.js",
    "metadata": "node scripts/metadata-cli.cjs",
    "keystatic:format-mdx": "node scripts/keystatic-format-mdx.mjs",
    "crowdin:hide-strings": "node scripts/crowdin-hide-strings.mjs",
    "crowdin:hide-strings:apply": "node scripts/crowdin-hide-strings.mjs --apply",
    "crowdin:translation-status": "node scripts/crowdin-translation-status.mjs",
    "validate-content": "node scripts/validate-content.mjs",
    "untrusted": "node scripts/untrusted-worktree.mjs",
    "prebuild": "(pnpm audit --audit-level high || true) && (pnpm fetch:eol || true) && pnpm validate-content",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "buildstatic": "BUILD_MODE=static pnpm build && pnpm check-build && pnpm check-links && pnpm validate-build",
    "postbuild": "bash scripts/postbuild.sh",
    "pdfs": "node scripts/build-pdfs.mjs",
    "pdfs:designed": "node scripts/build-designed-pdfs.mjs",
    "og-images": "node scripts/generate-og-images.mjs",
    "og-images:clean": "node scripts/generate-og-images.mjs --clean",
    "index": "NODE_ENV=${NODE_ENV} bash scripts/build-search-index.sh",
    "rss": "node scripts/generate-rss.mjs",
    "llms-txt": "node scripts/build-llms-txt.cjs",
    "seo:audit": "node scripts/seo-audit.cjs",
    "seo:audit:strict": "node scripts/seo-audit.cjs --strict",
    "check-links": "node scripts/check-links.mjs",
    "healthcheck-ssl": "bash scripts/healthcheck-ssl.sh",
    "healthcheck-domain": "bash scripts/healthcheck-domain.sh",
    "healthcheck-api": "bash scripts/healthcheck-api.sh",
    "healthcheck-canary": "node --env-file-if-exists=.env --env-file-if-exists=.env.production scripts/healthcheck-canary.mjs",
    "healthcheck-keystatic": "node --env-file-if-exists=.env --env-file-if-exists=.env.production scripts/healthcheck-keystatic.mjs",
    "check-build": "node scripts/check-build.mjs",
    "validate-build": "node scripts/validate-build.mjs",
    "canary": "node scripts/canary.mjs",
    "serve": "npx serve out",
    "deploy": "bash scripts/deploy.sh",
    "deploy:remote": "bash scripts/deploy-remote.sh",
    "deploy:assets": "bash scripts/deploy-assets.sh",
    "deploy:secrets": "bash scripts/deploy-secrets.sh",
    "snapshot": "node scripts/snapshot.mjs",
    "snapshot-normalize": "node scripts/snapshot-normalize.mjs",
    "snapshot-compare": "node scripts/snapshot-compare.mjs",
    "compare": "node scripts/compare.mjs",
    "annotations:cleanup": "tsx scripts/annotations-cleanup.mjs",
    "annotations:init": "tsx scripts/annotations-init.mjs",
    "rrc:link": "node scripts/rrc-link.mjs link",
    "rrc:unlink": "node scripts/rrc-link.mjs unlink",
    "rrc:status": "node scripts/rrc-link.mjs status",
    "api:dev": "source .env && fastify start --options --watch --ignore-watch '.git node_modules out .next content public scripts utils styles pages config compontents' --log-level info --pretty-logs --port ${API_PORT:-4321} api/server.js",
    "api:start": "pnpm exec pm2 start ecosystem.config.js",
    "api:stop": "pnpm exec pm2 stop ac-api",
    "api:restart": "pnpm exec pm2 restart ac-api",
    "api:status": "pnpm exec pm2 status ac-api",
    "api:delete": "pnpm exec pm2 delete ac-api",
    "api:logs": "pnpm exec pm2 logs ac-api",
    "mongo:start": "sh -c 'docker start ac-mongo >/dev/null 2>&1 || docker run -d --name ac-mongo -p 27017:27017 -v ac-mongo-data:/data/db mongo:7'"
  },
  "dependencies": {
    "@activistchecklist/react-review-comments": "^0.3.1",
    "@activistchecklist/umami-extra-privacy": "github:ActivistChecklist/umami-extra-privacy#cdc7422d143c17ca647133200785d52ac589e259",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@hookform/resolvers": "^6.0.2",
    "@keystar/ui": "~0.10.0",
    "@keystatic/core": "^0.6.9",
    "@keystatic/next": "^5.0.5",
    "@next/env": "^16.4.5",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@recogito/text-annotator": "^4.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "fluent-ffmpeg": "^2.1.3",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.70.0",
    "mongodb": "^7.8.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "openpgp": "^6.3.2",
    "openseadragon": "^6.1.1",
    "pdf-lib": "^1.17.1",
    "pm2": "^7.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "rehype-sanitize": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/open-sans": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "chalk": "^6.0.1",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "concurrently": "^10.0.6",
    "fastify-cli": "^8.0.3",
    "feed": "^6.0.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "next-sitemap": "^4.2.3",
    "node-fetch": "^3.3.2",
    "open-graph-scraper": "^6.13.0",
    "pagefind": "^1.6.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "react-json-view": "^1.21.3",
    "rss-parser": "^3.13.0",
    "satori": "^0.63.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
