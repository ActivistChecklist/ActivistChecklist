# Used when rsyncing out/ to the server (deploy-remote.sh, build-deploy.sh).
# Patterns match filenames at each level under the source dir (out/).

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Dependencies (should not appear in out/)
node_modules
.pnp
.pnp.js

# Secrets & env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# VCS & CI
.git
.github
.gitignore
.gitattributes

# Webhook (server-managed; must be protected from rsync --delete)
# Without these, `out/webhooks/` lacks gitignored files, so --delete would remove them from docroot.
webhooks/deploy-webhook.error.log
webhooks/webhook-secrets.local.php

# Large files only on the server (scp or SFTP into docroot large-assets/).
# Same rule as webhooks: excluded paths are not deleted by rsync --delete.
large-assets/***

# EOL snapshot is server-owned: the daily cron and the build's prebuild step both
# write it straight to the docroot via EOL_SNAPSHOT_PATH (.env.production). The
# copy inside out/ comes from the repo's public/data/ and is stale, so without
# this exclude every deploy would overwrite the fresh docroot copy with it.
data/eol-snapshot.json

# Build / dev artifacts
out
.next
buildbackups
coverage
.turbo
.vercel
.cursor
.idea
.vscode
*.log

# Uncomment to omit source maps from uploads
# *.map
