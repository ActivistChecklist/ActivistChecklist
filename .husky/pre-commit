#!/usr/bin/env sh
set -e

echo "→ pre-commit: strip media metadata (staged files)"
node scripts/pre-commit-metadata.cjs

# Fix internal paths to use trailing slashes (Next.js trailingSlash: true).
# Run per staged file from the shell so git context matches `git commit` (IDE or CLI).
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(mdx|md|js|jsx|ts|tsx|mjs|cjs|json|yaml|yml)$' || true)
if [ -n "$STAGED" ]; then
  echo "→ pre-commit: trailing slashes on internal paths"
  echo "$STAGED" | while IFS= read -r rel; do
    [ -z "$rel" ] && continue
    [ -f "$rel" ] || continue
    node scripts/trailing-slash-paths.mjs --fix "$rel"
    git add -f -- "$rel"
  done
fi

# Format staged files with the repo's Prettier config, so the result does not
# depend on which editor (or editor settings) the contributor used.
# Files in .prettierignore and types Prettier does not know are skipped.
# Symlinks (AGENTS.md) are left out: Prettier errors on a symlink passed by
# name, and the file it points at is checked under its own name.
FORMAT=$(git diff --cached --name-only --diff-filter=ACM | while IFS= read -r f; do [ -L "$f" ] || printf '%s\n' "$f"; done || true)
if [ -n "$FORMAT" ]; then
  echo "→ pre-commit: prettier"
  echo "$FORMAT" | tr '\n' '\0' | xargs -0 pnpm exec prettier --write --ignore-unknown --log-level warn
  echo "$FORMAT" | tr '\n' '\0' | xargs -0 git add -f --
fi

# One line when everything passes, full output when something fails. The
# reporter is hook-only; `pnpm test` and CI still use Vitest's default.
# --experimental.diagnostics=false drops the "Isolate ... workers spawned" hint.
# Worktrees run this hook from the main checkout, so a branch cut before the
# reporter existed falls back to plain `pnpm test`.
echo "→ pre-commit: unit tests"
if [ -f scripts/lib/vitest-hook-reporter.mjs ]; then
  pnpm exec vitest run --reporter=./scripts/lib/vitest-hook-reporter.mjs --experimental.diagnostics=false
else
  pnpm test
fi
